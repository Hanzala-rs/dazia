# Copy to .env and adjust. Placeholder values only — never put secrets here.
# SQLite database file (created if missing)
DAZIA_DB_PATH=dazia.db
# Local Ollama server URL
DAZIA_OLLAMA_URL=http://127.0.0.1:11434
# Ollama model name (must be pulled: ollama pull qwen3.5:4b)
DAZIA_OLLAMA_MODEL=qwen3.5:4b
# Seconds to wait for one model response (CPU can be slow)
DAZIA_OLLAMA_TIMEOUT_S=120
# IANA time zone, e.g. Asia/Karachi (blank = use the system time zone)
DAZIA_TIMEZONE=
# Bind address. 127.0.0.1 = this laptop only (safe default).
# 0.0.0.0 or a LAN IP lets your phone on home Wi-Fi connect; DAZIA refuses to start that way
# unless DAZIA_PASSPHRASE_HASH is set. Also run scripts\allow-lan.ps1 as Administrator.
DAZIA_HOST=127.0.0.1
# Web server port
DAZIA_PORT=8000
# Maximum characters per chat message
DAZIA_MAX_MESSAGE_CHARS=2000
# Login passphrase HASH (not the passphrase). Empty = no login, only allowed with DAZIA_HOST=127.0.0.1.
# Generate: .venv\Scripts\python -m app.auth   then paste the printed line here.
DAZIA_PASSPHRASE_HASH=
# Days a phone/browser stays logged in
DAZIA_SESSION_DAYS=30
# Voice (all local). Switch input/output off independently.
DAZIA_STT_ENABLED=true
DAZIA_TTS_ENABLED=true
# faster-whisper model: tiny.en (fastest), base.en (default), small.en (slower, more accurate)
DAZIA_STT_MODEL=base.en
# Piper voice file; download with: .venv\Scripts\python -m piper.download_voices en_US-lessac-medium --download-dir models/piper
DAZIA_TTS_VOICE=models/piper/en_US-lessac-medium.onnx
